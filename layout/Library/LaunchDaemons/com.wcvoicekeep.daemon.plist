<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wcvoicekeep.daemon</string>
	<key>Program</key>
	<string>/var/jb/usr/bin/wcvoicekeep</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/wcvoicekeep</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>ExecuteAllowed</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/log/wcvoicekeep.daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/wcvoicekeep.daemon.err</string>
</dict>
</plist>
